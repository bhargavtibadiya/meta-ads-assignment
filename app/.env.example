# Copy this file to `.env` and fill in local values.

# Database
DATABASE_URL="postgresql://bhargav@localhost:5432/meta_ads?schema=public"

# Meta Marketing API
# "fixtures" = read app/fixtures/*.json (Option B — no live Meta account)
# "live" = call the Graph API (requires META_ACCESS_TOKEN + META_AD_ACCOUNT_ID)
META_DATA_SOURCE=fixtures
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v22.0
META_ATTRIBUTION_WINDOWS=7d_click,1d_view
META_INSIGHTS_LOOKBACK_DAYS=28

# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Optional — used only by `npm run metabase:provision`
METABASE_URL=http://localhost:3000
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=MetaAdsAdmin1
